    "intercepted_by_phone": {
      "type": "string",
      "description": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d \u043f\u0440\u043e\u0440\u0430\u0431\u0430, \u043f\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0438\u0432\u0448\u0435\u0433\u043e \u043e\u0441\u0442\u0430\u0442\u043e\u043a"
