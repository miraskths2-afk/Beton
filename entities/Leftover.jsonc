    },
    "direction": {
      "type": "string",
      "description": "\u041d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 / \u0440\u0430\u0439\u043e\u043d (\u043d\u0430\u043f\u0440. \u0422\u0430\u043b\u0433\u0430\u0440\u0441\u043a\u0430\u044f \u0442\u0440\u0430\u0441\u0441\u0430, \u0411\u0435\u0441\u0430\u0433\u0430\u0448)"
    },
    "price": {
      "type": "number",
      "description": "\u0426\u0435\u043d\u0430 \u0441\u043e \u0441\u043a\u0438\u0434\u043a\u043e\u0439 (\u0442\u0433)"
    },
    "driver_id": {
      "type": "string",
      "description": "ID \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f"
    },
    "driver_name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f"
    },
    "phone": {
      "type": "string",
      "description": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f"
    },
    "status": {
      "type": "string",
