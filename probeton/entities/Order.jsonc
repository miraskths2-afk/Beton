{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "\u041d\u043e\u043c\u0435\u0440 \u0437\u0430\u043a\u0430\u0437\u0430 (\u0434\u043b\u044f \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f)"
    },
    "what_needed": {
      "type": "string",
      "description": "\u0427\u0442\u043e \u043d\u0443\u0436\u043d\u043e \u0438 \u043a\u0443\u0434\u0430 \u0432\u0435\u0437\u0442\u0438"
    },
    "phone": {
      "type": "string",
      "description": "\u041d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430 \u043a\u043b\u0438\u0435\u043d\u0442\u0430"
    },
    "order_type": {
      "type": "string",
      "enum": [
        "quick",
        "calculator"
      ],
      "default": "quick",
      "description": "\u0422\u0438\u043f \u0437\u0430\u043a\u0430\u0437\u0430: \u0431\u044b\u0441\u0442\u0440\u044b\u0439 \u0438\u043b\u0438 \u0447\u0435\u0440\u0435\u0437 \u043a\u0430\u043b\u044c\u043a\u0443\u043b\u044f\u0442\u043e\u0440"
    },
    "grade": {
      "type": "string",
      "description": "\u041c\u0430\u0440\u043a\u0430 \u0431\u0435\u0442\u043e\u043d\u0430",
      "enum": [
        "\u041c150",
        "\u041c200",
        "\u041c300",
        "\u041c400"
      ]
    },
    "price_per_cube": {
      "type": "number",
      "description": "\u0426\u0435\u043d\u0430 \u0437\u0430 \u043a\u0443\u0431 (\u0442\u0433)"
    },
    "cubes": {
      "type": "number",
      "description": "\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043a\u0443\u0431\u043e\u0432"
    },
    "total": {
      "type": "number",
      "description": "\u0418\u0442\u043e\u0433\u043e\u0432\u0430\u044f \u0441\u0443\u043c\u043c\u0430 (\u0442\u0433)"
    },
    "delivery_address": {
      "type": "string",
      "description": "\u0410\u0434\u0440\u0435\u0441 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438"
    },
    "mixer_time": {
      "type": "string",
      "description": "\u0412\u0440\u0435\u043c\u044f \u043f\u043e\u0434\u0430\u0447\u0438 \u043c\u0438\u043a\u0441\u0435\u0440\u0430"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_progress",
        "sent_to_plant",
        "manufacturing",
        "en_route",
        "done"
      ],
      "default": "new",
      "description": "\u0421\u0442\u0430\u0442\u0443\u0441 \u0437\u0430\u043a\u0430\u0437\u0430"
    },
    "driver_id": {
      "type": "string",
      "description": "ID \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f, \u043f\u0440\u0438\u043d\u044f\u0432\u0448\u0435\u0433\u043e \u0437\u0430\u043a\u0430\u0437"
    },
    "driver_name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f"
    },
    "client_paid": {
      "type": "boolean",
      "default": false,
      "description": "\u041a\u043b\u0438\u0435\u043d\u0442 \u043d\u0430\u0436\u0430\u043b '\u042f \u043e\u043f\u043b\u0430\u0442\u0438\u043b'"
    },
    "commission_paid": {
      "type": "boolean",
      "default": false,
      "description": "\u0410\u0434\u043c\u0438\u043d \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043b \u043e\u043f\u043b\u0430\u0442\u0443 \u0441\u0435\u0440\u0432\u0438\u0441\u043d\u043e\u0433\u043e \u0441\u0431\u043e\u0440\u0430"
    },
    "client_rating": {
      "type": "number",
      "description": "\u041e\u0446\u0435\u043d\u043a\u0430 \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044f \u043a\u043b\u0438\u0435\u043d\u0442\u043e\u043c (1-5)"
    },
    "driver_rating": {
      "type": "number",
      "description": "\u041e\u0446\u0435\u043d\u043a\u0430 \u043a\u043b\u0438\u0435\u043d\u0442\u0430 \u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0435\u043c (1-5)"
    }
  },
  "required": [
    "what_needed",
    "phone"
  ]
}
